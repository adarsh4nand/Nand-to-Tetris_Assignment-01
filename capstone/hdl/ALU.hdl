// ALU.hdl -- Nand to Tetris capstone (Hack computer), built from Nand.
// ETCNTC301 / ETCCNT301 -- K.R. Mangalam University

CHIP ALU {
    IN x[16], y[16], zx, nx, zy, ny, f, no;
    OUT out[16], zr, ng;

    PARTS:
    // zx: zero the x input
    Mux16(a=x, b=false, sel=zx, out=x1);
    // nx: negate the x input
    Not16(in=x1, out=notx1);
    Mux16(a=x1, b=notx1, sel=nx, out=x2);
    // zy / ny on the y input
    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=noty1);
    Mux16(a=y1, b=noty1, sel=ny, out=y2);
    // f: 0 = And, 1 = Add
    And16(a=x2, b=y2, out=anded);
    Add16(a=x2, b=y2, out=added);
    Mux16(a=anded, b=added, sel=f, out=funcOut);
    // no: negate the output
    Not16(in=funcOut, out=notFuncOut);
    Mux16(a=funcOut, b=notFuncOut, sel=no, out=out, out[15]=ng, out[0..7]=low8, out[8..15]=high8);
    // status bits
    Or8Way(in=low8, out=orLow);
    Or8Way(in=high8, out=orHigh);
    Or(a=orLow, b=orHigh, out=anyBit);
    Not(in=anyBit, out=zr);
}
