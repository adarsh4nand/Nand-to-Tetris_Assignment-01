// Mux4Way16.hdl -- Nand to Tetris capstone (Hack computer), built from Nand.
// ETCNTC301 / ETCCNT301 -- K.R. Mangalam University

CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];

    PARTS:
    Mux16(a=a, b=b, sel=sel[0], out=outAB);
    Mux16(a=c, b=d, sel=sel[0], out=outCD);
    Mux16(a=outAB, b=outCD, sel=sel[1], out=out);
}
