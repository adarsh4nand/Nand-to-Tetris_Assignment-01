// CPU.hdl -- Nand to Tetris capstone (Hack computer), built from Nand.
// ETCNTC301 / ETCCNT301 -- K.R. Mangalam University

CHIP CPU {
    IN  inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // ---------- A register ----------
    // An A-instruction loads the whole 16-bit instruction word into A;
    // a C-instruction can load the ALU output into A (dest bit d1).
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);
    Not(in=instruction[15], out=notInstruction15);
    Or(a=notInstruction15, b=instruction[5], out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // ---------- D register ----------
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    // ---------- ALU inputs ----------
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);
    ALU(x=dOut, y=aluY,
        zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, out=outM, zr=aluZero, ng=aluNegative);


    // ---------- memory write ----------
    And(a=instruction[15], b=instruction[3], out=writeM);

    // ---------- program counter ----------
    // jump bits: instruction[2] = jlt, instruction[1] = jeq, instruction[0] = jgt
    // out > 0 means neither zero nor negative
    Or(a=aluZero, b=aluNegative, out=notPositive);
    Not(in=notPositive, out=aluPositive);
    And(a=instruction[15], b=instruction[2], out=jumpIfNegative);
    And(a=jumpIfNegative, b=aluNegative, out=jlt);
    And(a=instruction[15], b=instruction[1], out=jumpIfZero);
    And(a=jumpIfZero, b=aluZero, out=jeq);
    And(a=instruction[15], b=instruction[0], out=jumpIfPositive);
    And(a=jumpIfPositive, b=aluPositive, out=jgt);
    Or(a=jlt, b=jeq, out=jumpA);
    Or(a=jumpA, b=jgt, out=jump);
    PC(in=aOut, load=jump, inc=true, reset=reset, out[0..14]=pc);
}
