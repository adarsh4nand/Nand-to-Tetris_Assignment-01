// Mux.hdl -- Nand to Tetris capstone (Hack computer), built from Nand.
// ETCNTC301 / ETCCNT301 -- K.R. Mangalam University

CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=sel, out=notSel);
    And(a=a, b=notSel, out=aAndNotSel);
    And(a=b, b=sel, out=bAndSel);
    Or(a=aAndNotSel, b=bAndSel, out=out);
}
